FROM php:8.3-fpm AS builder

WORKDIR /var/www

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    autoconf \
    libmemcached-dev \
    libevent-dev \
    zlib1g-dev \
    libsasl2-dev \
    libpq-dev \
    libzip-dev \
    curl \
    git \
    unzip \
    libxml2-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    nginx \
    supervisor \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install pdo pdo_pgsql pdo_mysql zip bcmath sockets soap gd pcntl

RUN pecl install redis memcached && \
    docker-php-ext-enable redis memcached

RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

COPY composer.json composer.lock ./

RUN composer install --no-autoloader --no-scripts --no-progress --prefer-dist

COPY . .

RUN composer dump-autoload --optimize && \
    php artisan package:discover --ansi

FROM php:8.3-fpm

WORKDIR /var/www

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    libzip-dev \
    libxml2-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libmemcached-dev \
    supervisor \
    nginx \
    curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install pdo pdo_pgsql pdo_mysql zip bcmath sockets gd pcntl

RUN pecl install redis memcached && \
    docker-php-ext-enable redis memcached

COPY --from=builder /var/www /var/www

COPY docker/nginx/nginx-unified.conf /etc/nginx/nginx.conf
COPY docker/nginx/conf.d/app-unified.conf /etc/nginx/conf.d/default.conf

RUN groupadd -g 101 nginx && \
    useradd -u 101 -g nginx -s /sbin/nologin -d /nonexistent nginx

RUN sed -i 's/^user .*/user nginx;/' /etc/nginx/nginx.conf

RUN echo '[global]\n\
daemonize = no\n\
\n\
[www]\n\
listen = 9000\n\
listen.owner = www-data\n\
listen.group = www-data\n\
user = www-data\n\
group = www-data\n\
clear_env = no\n\
pm = dynamic\n\
pm.max_children = 20\n\
pm.start_servers = 4\n\
pm.min_spare_servers = 2\n\
pm.max_spare_servers = 8\n\
pm.max_requests = 500\n' > /usr/local/etc/php-fpm.d/zz-docker.conf

RUN rm -f /usr/local/etc/php-fpm.d/docker.conf

RUN sed -i 's/clear_env = .*/clear_env = no/' /usr/local/etc/php-fpm.d/www.conf

RUN sed -i 's/clear_env = .*/clear_env = no/' /usr/local/etc/php-fpm.d/zz-docker.conf 2>/dev/null || true

COPY docker/supervisor/supervisord-unified.conf /etc/supervisor/supervisord.conf
COPY docker/supervisor/horizon-unified.conf /etc/supervisor/conf.d/horizon.conf
COPY docker/supervisor/nginx-unified.conf /etc/supervisor/conf.d/nginx.conf
COPY docker/supervisor/php-fpm-unified.conf /etc/supervisor/conf.d/php-fpm.conf
COPY docker/supervisor/scheduler-unified.conf /etc/supervisor/scheduler.conf
COPY docker/php/php.ini /usr/local/etc/php/conf.d/custom.ini



RUN groupadd -g 1000 www-data || true && \
    useradd -u 1000 -g www-data -ms /bin/bash www-data || true

RUN mkdir -p /var/www/storage/app/public && \
    mkdir -p /var/www/storage/framework/{cache,sessions,testing,views} && \
    mkdir -p /var/www/storage/logs && \
    mkdir -p /var/log/nginx && \
    mkdir -p /var/log/php && \
    mkdir -p /var/log/supervisor && \
    mkdir -p /var/lib/nginx && \
    chown -R www-data:www-data /var/www/storage && \
    chown -R www-data:www-data /var/www/bootstrap/cache && \
    chown -R nginx:nginx /var/log/nginx /var/lib/nginx && \
    chown -R www-data:www-data /var/log/php && \
    chmod -R 775 /var/www/storage && \
    chmod -R 777 /var/www/storage/logs && \
    chmod -R 775 /var/www/bootstrap/cache && \
    chmod -R 755 /var/log/nginx /var/lib/nginx && \
    ln -sf /var/www/storage/app/public /var/www/public/storage

HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

EXPOSE 80

CMD ["supervisord", "-c", "/etc/supervisor/supervisord.conf", "-n"]