COMPOSE_PROJECT_NAME=vdnh-afisha-backend

HOST_UID=1000
HOST_GID=1000

APP_NAME="vdnh-afisha"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker (default):
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vdnh-afisha
DB_USERNAME=vdnh-afisha
DB_PASSWORD=vdnh-afisha

# Host-only without Docker (optional):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

LOG_CHANNEL=stack
LOG_LEVEL=debug
